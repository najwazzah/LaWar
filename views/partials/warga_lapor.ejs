<section class="warga-report-panel">
  <form action="/pengaduan" method="post" enctype="multipart/form-data" class="warga-form">
    <h2>Laporkan seluruh keluhanmu di sini!</h2>

    <div class="input-group">
      <label for="judul">📝 Judul Laporan</label>
      <input type="text" name="judul" id="judul" required placeholder="Tuliskan judul laporan">
    </div>

    <div class="input-group">
      <label for="detail">📄 Detail Laporan</label>
      <textarea name="detail" id="detail" required placeholder="Tuliskan detail laporan"></textarea>
    </div>

    <div class="input-group">
      <label for="instansi">🏢 Instansi</label>
      <select name="instansi" id="instansi" required>
        <option value="">Pilih instansi yang kamu tuju</option>
        <option value="Dinas Air">Dinas Air</option>
        <option value="Dinas Kebersihan">Dinas Kebersihan</option>
        <option value="Dinas Listrik">Dinas Listrik</option>
      </select>
    </div>

    <div class="input-group">
      <label for="jenis">📌 Jenis Laporan</label>
      <select name="jenis" id="jenis" required>
        <option value="">Pilih kategori laporan</option>
        <option value="Kerusakan">Kerusakan</option>
        <option value="Keamanan">Keamanan</option>
        <option value="Lingkungan">Lingkungan</option>
      </select>
    </div>

    <div class="input-group">
      <label for="lampiran">📎 Tambahkan Lampiran (JPG, PNG, PDF)</label>
      <input type="file" name="lampiran" id="lampiran" accept=".jpg,.png,.pdf">
    </div>

    <button type="submit" class="submit-btn">Laporkan</button>
  </form>
</section>
