<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - LaWar</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-page">
    <header class="admin-header">
        <div class="logo">LaWar!</div>
        <div class="header-right">
            <div class="batik-pattern"></div>
        </div>
    </header>

    <div class="admin-container">
        <aside class="admin-sidebar">
            <div class="admin-profile">
                <div class="profile-avatar">👨‍💼</div>
                <div class="admin-name">Admin</div>
                <div class="profile-role">Administrator</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="/dashboard/admin" class="<%= partial === null ? 'active' : '' %>"><span class="menu-icon">🏠</span>Dashboard</a></li>
                <li><a href="/admin/pengaduan" class="<%= partial === 'pengaduan' ? 'active' : '' %>"><span class="menu-icon">📨</span>Pengaduan</a></li>
                <li><a href="/admin/pengguna" class="<%= partial === 'pengguna' ? 'active' : '' %>"><span class="menu-icon">👥</span>Pengguna</a></li>
                <li class="logout"><a href="/logout"><span class="menu-icon">🚪</span>Logout</a></li>
            </ul>
        </aside>

        <main class="admin-main-content">
            <% if (!partial) { %>
                <div class="page-title">
                    <h1 class="welcome-message">Selamat Datang, Admin!</h1>
                    <p class="welcome-sub">Berikut ringkasan pengaduan dan pengguna saat ini.</p>
                </div>

                <div class="stats-container">
                    <div class="stat-card pending">
                        <div class="stat-header-horizontal">
                            <div class="stat-icon">📋</div>
                            <div class="stat-number">2</div>
                        </div>
                        <div class="stat-label">Pengaduan Menunggu</div>
                        <div class="stat-detail"><a href="/admin/pengaduan">Lihat detail →</a></div>
                    </div>

                    <div class="stat-card process">
                        <div class="stat-header-horizontal">
                            <div class="stat-icon">⏳</div>
                            <div class="stat-number">3</div>
                        </div>
                        <div class="stat-label">Pengaduan Ditanggapi</div>
                        <div class="stat-detail"><a href="/admin/pengaduan">Lihat detail →</a></div>
                    </div>

                    <div class="stat-card completed">
                        <div class="stat-header-horizontal">
                            <div class="stat-icon">✅</div>
                            <div class="stat-number">2</div>
                        </div>
                        <div class="stat-label">Pengaduan Selesai</div>
                        <div class="stat-detail"><a href="/admin/pengaduan">Lihat detail →</a></div>
                    </div>

                    <div class="stat-card users">
                        <div class="stat-header-horizontal">
                            <div class="stat-icon">👥</div>
                            <div class="stat-number">7</div>
                        </div>
                        <div class="stat-label">Pengguna</div>
                        <div class="stat-detail"><a href="/admin/pengguna">Lihat detail →</a></div>
                    </div>
                </div>
            <% } else { %>
                <%- include(partial, { data: data }) %>
            <% } %>
        </main>
    </div>
</body>
</html>